<Window x:Class="InfamousLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="inFAMOUS Second Son" Width="560" Height="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <StackPanel>
      <TextBlock Text="inFAMOUS Second Son" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
      <TextBlock Text="Kutay'ın ayarlarıyla, shadPS4 (AxylPup 1.1.1)" Foreground="{DynamicResource Fg2}" Margin="0,2,0,18"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Oyun klasörü" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
          <TextBlock x:Name="PathText" Text="Henüz seçilmedi" TextWrapping="Wrap" Foreground="{DynamicResource Fg2}" Margin="0,4,0,10"/>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
          <Button x:Name="PickBtn" Content="Klasör seç" Style="{StaticResource Btn}" HorizontalAlignment="Left" Click="Pick_Click"/>
        </StackPanel>
      </Border>

      <Button x:Name="PlayBtn" Content="Oyna" Style="{StaticResource Btn}" Background="#0A84FF" Foreground="White"
              FontSize="18" FontWeight="SemiBold" Padding="14,14" Margin="0,0,0,12" IsEnabled="False" Click="Play_Click"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Tuşlar (klavye ve fare)" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,0,6"/>
          <TextBlock x:Name="KeysText" Foreground="{DynamicResource Fg2}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" LineHeight="19"/>
          <TextBlock Text="Kol takılıysa doğrudan kolla da oynanır." Foreground="{DynamicResource Fg2}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
